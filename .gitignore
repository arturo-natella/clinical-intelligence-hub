# Clinical Intelligence Hub — .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environment
venv/
.venv/
env/

# Patient data — NEVER commit.
# Deliberately a blanket rule. This was previously an enumeration of
# subdirectories and extensions, and data/profiles/ — encrypted vaults plus an
# index.json holding profile names in PLAINTEXT — was added later and matched
# none of them (data/*.enc only matches direct children of data/). Nothing
# under data/ is tracked, so ignore the whole tree and let anything the
# pipeline creates in future be covered automatically.
data/

# Model weights — too large for git
models/

# Claude Code workspace
.claude/

# macOS
.DS_Store
Icon?
*.swp
*~

# IDE
.vscode/
.idea/
*.code-workspace

# Environment / secrets
.env
.env.local
*.pem
*.key

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
*.log

# Playwright
playwright/.cache/

# Generated reports (user-specific)
output/
*.docx
